{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Atlas scenario database",
 "definitions": {
  "ref": {"type":"string","pattern":"^l[12]:[A-Za-z0-9_./-]+$"},
  "basis": {"type":"array","items":{"$ref":"#/definitions/ref"}},
  "money": {"type":["number","null"]},
  "moment": {"type":"object","required":["id","name","customerId","asOf"],"properties":{"id":{"enum":["m1","m2","m3","m4"]},"name":{"type":"string"},"stage":{"type":"string"},"customerId":{"type":"string"},"asOf":{"type":"string","format":"date"},"tenure":{"type":"string"},"segment":{"type":"string"},"description":{"type":"string"}}},
  "account": {"type":"object","required":["id","productId","name","kind"],"properties":{"id":{"type":"string"},"productId":{"type":"string"},"name":{"type":"string"},"kind":{"enum":["current","credit","savings","investment","external"]},"masked":{"type":"string"},"balance":{"$ref":"#/definitions/money"},"owed":{"$ref":"#/definitions/money"},"limit":{"$ref":"#/definitions/money"},"paidInFull":{"type":"boolean"},"interestMonthly":{"$ref":"#/definitions/money"}}},
  "pot": {"type":"object","required":["id","name","kind","balance","monthlyRate","isDebt","rules"],"properties":{"id":{"type":"string"},"name":{"type":"string"},"kind":{"enum":["saving","goal","committed-plan","loan","investment","shared","locked","budget","credit","unnamed"]},"balance":{"type":"number"},"target":{"$ref":"#/definitions/money"},"monthlyRate":{"type":"number"},"growthAnnual":{"type":["number","null"]},"isDebt":{"type":"boolean"},"stopsAtTarget":{"type":"boolean"},"members":{"type":["array","null"],"items":{"type":"object","required":["memberId","role"]}},"rules":{"type":"array","items":{"type":"string"}},"later":{"type":"object","properties":{"from":{"type":"integer"},"rate":{"type":"number"}}}}},
  "rule": {"type":"object","required":["id","potId","type","amount","active"],"properties":{"id":{"type":"string"},"potId":{"type":"string"},"type":{"enum":["payday-fixed","round-up","percentage","remaining-on-payday","challenge","repayment","cap","later","standing-watch"]},"amount":{"type":"number"},"source":{"type":["string","null"]},"since":{"type":"string"},"active":{"type":"boolean"},"stopsAt":{"type":"number"},"condition":{"type":"string"}}},
  "transaction": {"type":"object","required":["id","date","ledger","counterparty","category","amount","direction"],"properties":{"id":{"type":"string"},"date":{"type":"string","format":"date"},"ledger":{"type":"string"},"counterparty":{"type":"string"},"category":{"type":"string"},"amount":{"type":"number"},"direction":{"enum":["in","out","note"]},"ruleId":{"type":["string","null"]},"memberId":{"type":["string","null"]},"receipt":{"type":"boolean"}}},
  "L1": {"type":"object","required":["layer","moment","asOf","customer","household","productsHeld","accounts","pots","rules","income","bills","transactions","ledgerOpeningBalances","spending","credit","savingsAndInvestments","netWorth","moneySpeed","goals","rewards","relationship","behaviour","autonomy"],
   "properties":{"layer":{"const":1},"moment":{"$ref":"#/definitions/moment"},"accounts":{"type":"array","items":{"$ref":"#/definitions/account"}},"pots":{"type":"array","items":{"$ref":"#/definitions/pot"}},"rules":{"type":"array","items":{"$ref":"#/definitions/rule"}},"transactions":{"type":"array","items":{"$ref":"#/definitions/transaction"}},
    "netWorth":{"type":"object","required":["held","owed","net"],"properties":{"held":{"type":"number"},"owed":{"type":"number"},"net":{"type":"number"}}},
    "rewards":{"type":"object","properties":{"points":{"type":"object","required":["balance","ledger"]},"cashback":{"type":["object","null"]}}}}},
  "signal": {"type":"object","required":["id","kind","description","basis"],"properties":{"id":{"type":"string"},"kind":{"type":"string"},"description":{"type":"string"},"basis":{"$ref":"#/definitions/basis"},"detectedOn":{"type":"string"}}},
  "whatIf": {"type":"object","required":["id","type","title","summary","effect","canCommit","basis"],"properties":{"type":{"enum":["create","attach","redirect","cap","illustration","rehearsal"]},"effect":{"type":"object"},"canCommit":{"type":"boolean"},"basis":{"$ref":"#/definitions/basis"}}},
  "story": {"type":"object","required":["id","state","title","claim","verb","residue","basis"],"properties":{"state":{"enum":["new","pending","saved"]},"rows":{"type":"array"},"action":{"type":["string","null"]},"basis":{"$ref":"#/definitions/basis"}}},
  "L2": {"type":"object","required":["layer","moment","customerId","signals","insights","personality","beliefs","companion","stories","whatIfs","projections","nextBestActions","recommendations","opportunities","risks"],
   "properties":{"layer":{"const":2},"signals":{"type":"array","items":{"$ref":"#/definitions/signal"}},"whatIfs":{"type":"array","items":{"$ref":"#/definitions/whatIf"}},"stories":{"type":"array","items":{"$ref":"#/definitions/story"}},
    "projections":{"type":"object","required":["horizonMonths","perPot","netWorth"],"properties":{"horizonMonths":{"const":120}}}}}
 }
}
